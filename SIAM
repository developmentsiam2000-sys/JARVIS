    programming: { patterns: ['programming','coding','code'], reply: "Programming is giving computers step-by-step instructions to perform tasks. Popular languages include Python, JavaScript, C++, and Java." },
    html: { patterns: ['html','webpage'], reply: "HTML is the standard markup language for creating web pages. It stands for HyperText Markup Language." },
    css: { patterns: ['css','style'], reply: "CSS styles web pages – controls colors, layout, fonts, and how things look. It stands for Cascading Style Sheets." },
