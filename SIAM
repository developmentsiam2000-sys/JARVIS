    cricket: { patterns: ['cricket','t20','odi'], reply: "Cricket is a bat-and-ball sport popular in Bangladesh, India, Pakistan, England, and Australia. Bangladesh's national team is very strong in T20." },
    football: { patterns: ['football','soccer','fifa'], reply: "Football is the world's most popular sport. The FIFA World Cup is held every 4 years." },
    time: { patterns: ['time','what time'], reply: () => `Current system time: ${new Date().toLocaleTimeString()}` },
    date: { patterns: ['date','today date'], reply: () => `Today's date: ${new Date().toLocaleDateString('en-BD', {day:'numeric',month:'long',year:'numeric'})}` },
    day: { patterns: ['day','what day'], reply: () => `Today is ${new Date().toLocaleDateString('en-US', {weekday:'long'})}` },
    help: { patterns: ['help','commands','what can you do'], reply: `I can help you with:\n👋 Greetings\n😂 Jokes\n📚 Science\n🌍 Geography\n🏛️ History\n💻 Programming\n🌐 Web Dev\n🇧🇩 Bangladesh\n🎬 Movies\n⚽ Sports\n🧮 Math\n🕒 Time/Date\n🔐 Passwords\n🪙 Coin Flip\n🎲 Dice Roll\n📝 Notes\n💡 Tips\n👨‍💻 About Developer` }
};

// ==============================================
// 🧮 FULLY FIXED MATH ENGINE
// Works with: "what is 213+45439", "calculate 100*5", pure numbers
// ==============================================
function solveMath(input) {
    try {
        let expr = input
            .replace(/what is|calculate|equals|=|plus|add|minus|subtract|times|multiply|divide/gi, '')
            .replace(/×/g,'*').replace(/÷/g,'/').trim();

        if (!/[\d+\-*/.()^%]/.test(expr)) return null;

        expr = expr
            .replace(/pi/gi, Math.PI).replace(/sqrt/gi,'Math.sqrt')
            .replace(/pow\s*\(/gi,'Math.pow(').replace(/sin\s*\(/gi,'Math.sin(')
            .replace(/cos\s*\(/gi,'Math.cos(').replace(/tan\s*\(/gi,'Math.tan(');

        const result = Function('"use strict";return (' + expr + ')')();
        if (!isNaN(result) && isFinite(result)) {
            return `🧮 Calculation Complete:\n**${input.trim()} = ${Number.isInteger(result)?result:result.toFixed(4)}**`;
        }
        return null;
    } catch { return null; }
}

// ==============================================
// 🛠️ ALL UTILITY TOOLS ADDED
// ==============================================
function runTools(input) {
    const t = input.toLowerCase();
    if (t.includes('password') || t.includes('generate password')) {
        const len = t.match(/\d+/) ? parseInt(t.match(/\d+/)[0]) : 12;
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*';
        let pass = '';
        for(let i=0;i<Math.min(len,32);i++) pass += chars[Math.floor(Math.random()*chars.length)];
        return `🔐 Generated Password:\n\`${pass}\``;
    }
    if (t.includes('count') && (t.includes('word') || t.includes('text'))) {
        const words = input.replace(/count.*?:?/i,'').trim();
        return `📊 Text Statistics:\n• Characters: ${words.length}\n• Words: ${words.split(/\s+/).filter(w=>w).length}`;
    }
    if (t.includes('coin') || t.includes('flip')) {
        return `🪙 Coin Flip Result: **${Math.random()>0.5?'Heads':'Tails'}**`;
    }
    if (t.includes('dice') || t.includes('roll')) {
        return `🎲 Dice Roll Result: **${Math.floor(Math.random()*6)+1}**`;
    }
    return null;
}

function processAI(userText) {
    const text = userText.trim();
    const lower = text.toLowerCase();

    const mathRes = solveMath(text);
    if (mathRes) return mathRes;

    const toolRes = runTools(text);
    if (toolRes) return toolRes;

    for(const cat in KNOWLEDGE) {
        const entry = KNOWLEDGE[cat];
        if(entry.patterns.some(p => lower.includes(p))) {
            if(typeof entry.reply === 'function') return entry.reply();
            if(Array.isArray(entry.replies)) return entry.replies[Math.floor(Math.random()*entry.replies.length)];
            return entry.reply;
        }
    }

    return `🔍 I received your query: "${text}"\nType "help" to see all categories I can help you with!`;
}

function speakText(text) {
    if(!speakEnabled) return;
    window.speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(text.replace(/[*#`]/g,''));
    utter.rate = 1; utter.pitch = 1;
    window.speechSynthesis.speak(utter);
}

if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SR();
    recognition.continuous = false; recognition.interimResults = false;
    recognition.onresult = e => { userInput.value = e.results[0][0].transcript; sendMessage(); };
}

function addMessage(text, isUser) {
    const div = document.createElement('div');
    div.className = `flex gap-3 ${isUser?'justify-end':''}`;
    div.innerHTML = isUser ? `
        <div class="bg-jarvis-blue/40 p-4 rounded-2xl rounded-tr-none max-w-[85%]"><p class="text-gray-100 whitespace-pre-wrap">${text}</p></div>
        <div class="w-9 h-9 rounded-full bg-gray-600 flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-user text-sm"></i></div>
    ` : `
        <div class="w-9 h-9 rounded-full bg-jarvis-blue flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-microchip text-sm"></i></div>
        <div class="bg-jarvis-dark/60 p-4 rounded-2xl rounded-tl-none max-w-[85%]"><p class="text-gray-100 whitespace-pre-wrap">${text}</p></div>
    `;
    chatBox.appendChild(div);
    chatBox.scrollTop = chatBox.scrollHeight;
    if(!isUser) speakText(text);
}

function showTyping() {
    const div = document.createElement('div');
    div.id = 'typing';
    div.className = 'flex gap-3';
    div.innerHTML = `
        <div class="w-9 h-9 rounded-full bg-jarvis-blue flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-microchip text-sm"></i></div>
        <div class="bg-jarvis-dark/60 p-4 rounded-2xl rounded-tl-none flex gap-1">
            <span class="typing-dot w-2 h-2 bg-gray-300 rounded-full"></span>
            <span class="typing-dot w-2 h-2 bg-gray-300 rounded-full"></span>
            <span class="typing-dot w-2 h-2 bg-gray-300 rounded-full"></span>
        </div>`;
    chatBox.appendChild(div);
    chatBox.scrollTop = chatBox.scrollHeight;
}

function hideTyping() { const t = document.getElementById('typing'); if(t) t.remove(); }

function sendMessage() {
    const msg = userInput.value.trim();
    if(!msg) return;
    addMessage(msg, true);
    userInput.value = '';
    showTyping();
    setTimeout(() => {
        hideTyping();
        addMessage(processAI(msg), false);
    }, 600);
}

sendBtn.addEventListener('click', sendMessage);
userInput.addEventListener('keydown', e=>{if(e.key==='Enter')sendMessage();});
clearBtn.addEventListener('click', ()=>{chatBox.innerHTML=''; addMessage('Console cleared. Ready.', false);});
speakBtn.addEventListener('click', ()=>{
    speakEnabled = !speakEnabled;
    speakBtn.style.color = speakEnabled ? '#00d4ff' : '#888';
});
voiceBtn.addEventListener('click', ()=>{
    if(!recognition) { addMessage('Voice input not supported in this browser.', false); return; }
    recognition.start();
    voiceBtn.style.color = '#ff4444';
    recognition.onend = ()=>{ voiceBtn.style.color = '#fff'; };
});
    </script>
</body>
</html>
