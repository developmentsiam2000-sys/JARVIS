    },
    earth: { patterns: ['earth','world','planet earth'], reply: "Earth is the third planet from the Sun, the only known planet with life. It formed ~4.5 billion years ago, 71% covered in water, with an oxygen-rich atmosphere." },
    sun: { patterns: ['sun','star'], reply: "The Sun is a G-type main-sequence star at our solar system's center. It is 150 million km from Earth, made mostly of hydrogen and helium, and provides all our light and heat." },
    moon: { patterns: ['moon','lunar'], reply: "The Moon is Earth's only natural satellite. It orbits us every 27 days, causes tides, and reflects sunlight at night." },
    water: { patterns: ['water','h2o'], reply: "Water is H₂O – two hydrogen atoms + one oxygen. It is essential for all known life, exists as liquid, solid (ice), and gas (vapor)." },
    ai: { patterns: ['ai','artificial intelligence'], reply: "Artificial Intelligence is computer science that creates systems able to learn, reason, solve problems, and answer questions similar to human intelligence." },
    gravity: { patterns: ['gravity','gravitation'], reply: "Gravity is the natural force that pulls objects toward each other. It keeps planets orbiting stars, and us on the ground." },
    atom: { patterns: ['atom','atomic'], reply: "Atoms are the basic building blocks of all matter. They contain protons, neutrons, and electrons." },
    light: { patterns: ['light','speed of light'], reply: "Light travels at ~299,792 km per second – the fastest thing in the universe. It acts as both a wave and a particle." },
